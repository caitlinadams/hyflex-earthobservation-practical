{
	"name": "Hyflex Earth Observation Practical",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12",
	"onCreateCommand": "pip3 install --user -r requirements.txt && python3 -m ipykernel install --user --name devcontainer --display-name 'Python (AER20002)'",
	"hostRequirements": {
		"cpus": 4,
		"memory": "16gb",
		"storage": "16gb"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"jupyter.jupyterServerType": "local",
		        "jupyter.notebookFileRoot": "${workspaceFolder}/practical",
		        "jupyter.kernels.filter": [
					{"path": "/home/vscode/.local/share/jupyter/kernels/devcontainer"}
				],
				"python.experiments.optOutFrom": ["All"],
		        "workbench.colorTheme": "GitHub Light Default"
			},
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"GitHub.github-vscode-theme"
			]
		}
	},
}
