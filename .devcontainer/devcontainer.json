{
	"name": "Hyflex Earth Observation Practical",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12",
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": "true",
      		"upgradePackages": "true"
    	},
		"git-lfs": "latest"
	},
	"onCreateCommand": "python3 -m pip install -r requirements.txt",
	"postCreateCommand": "python3 -m pip install -r requirements.txt",
	"hostRequirements": {
		"cpus": 2,
		"memory": "16gb",
		"storage": "16gb"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python3",
				"jupyter.jupyterServerType": "local",
		        "jupyter.notebookFileRoot": "${workspaceFolder}/practical",
		        "jupyter.kernels.filter": [
					{"path": "/usr/local/bin/python3"}
				],
		        "workbench.colorTheme": "GitHub Light Default"
			},
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter"
			]
		}
	},
	"remoteUser": "vscode"
}
